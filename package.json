{
  "name": "devlog-architect",
  "displayName": "Dev-Log Architect",
  "description": "Extract context from your coding sessions—case studies, trade-offs, and interview prep from real git history.",
  "version": "0.1.0",
  "publisher": "devlog-architect",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:devlog.export",
    "onCommand:devlog.generateCaseStudy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "devlog.export",
        "title": "Dev-Log: Export Case Study (last 3 commits)"
      },
      {
        "command": "devlog.generateCaseStudy",
        "title": "Dev-Log: Generate Case Study from Active File"
      }
    ],
    "configuration": {
      "title": "Dev-Log Architect",
      "properties": {
        "devlogArchitect.openaiCompatibleBaseUrl": {
          "type": "string",
          "default": "https://api.openai.com/v1",
          "description": "OpenAI-compatible API base URL (no trailing slash)."
        },
        "devlogArchitect.model": {
          "type": "string",
          "default": "gpt-4o-mini",
          "description": "Model id for case-study generation."
        },
        "devlogArchitect.maxDiffChars": {
          "type": "number",
          "default": 120000,
          "description": "Max characters of combined diff sent to the LLM (truncated if larger)."
        },
        "devlogArchitect.skipLlm": {
          "type": "boolean",
          "default": false,
          "description": "If true, export a Markdown template with raw diffs only (no API key prompt)."
        },
        "devlogArchitect.maxFileSnippetChars": {
          "type": "number",
          "default": 12000,
          "description": "Max characters of the active file sent to the LLM for file-based dev logs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/imports.test.js",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "typescript": "^5.3.0"
  }
}
